// Dumpy 데이터베이스 스키마
// 개발·프로덕션 모두 PostgreSQL
//
// SQLite에서 옮겨온 이유: Vercel은 파일시스템이 휘발성이라 SQLite 파일이
// 배포마다 사라진다. Prisma는 provider를 환경변수로 바꿀 수 없어서
// (반드시 리터럴이어야 한다) 개발도 같은 provider를 써야 한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // 앱이 쓰는 연결. Neon 등에서는 풀러(-pooler) 주소를 넣는다.
  // 서버리스는 요청마다 연결이 늘어나므로 풀링이 없으면 연결 한도에 걸린다.
  url = env("DATABASE_URL")

  // 마이그레이션 전용 연결. 풀러를 거치지 않는 직결 주소를 넣는다.
  // PgBouncer 같은 풀러는 트랜잭션·advisory lock 을 제대로 못 넘겨서
  // migrate deploy 가 실패한다.
  directUrl = env("DIRECT_URL")
}

// 사용자
model User {
  id              String   @id @default(cuid())
  provider        String   // "toss" | "web"
  providerUserId  String
  agreedAt        DateTime
  ageConfirmedAt  DateTime
  createdAt       DateTime @default(now())

  memos Memo[]

  @@unique([provider, providerUserId])
  @@map("users")
}

// 메모
model Memo {
  id           String    @id @default(cuid())
  userId       String
  content      String
  category     String    // "todo" | "diary" | "collected" | "etc"
  classifiedBy String    // "auto" | "manual"
  autoCategory String?
  confidence   Float     @default(0)
  hasDeadline  Boolean   @default(false)
  isDone       Boolean   @default(false)
  doneAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category])
  @@index([userId, deletedAt])
  @@map("memos")
}
