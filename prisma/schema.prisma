// Dumpy 데이터베이스 스키마
// 개발·프로덕션 모두 PostgreSQL
//
// SQLite에서 옮겨온 이유: Vercel은 파일시스템이 휘발성이라 SQLite 파일이
// 배포마다 사라진다. Prisma는 provider를 환경변수로 바꿀 수 없어서
// (반드시 리터럴이어야 한다) 개발도 같은 provider를 써야 한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 사용자
model User {
  id              String   @id @default(cuid())
  provider        String   // "toss" | "web"
  providerUserId  String
  agreedAt        DateTime
  ageConfirmedAt  DateTime
  createdAt       DateTime @default(now())

  memos Memo[]

  @@unique([provider, providerUserId])
  @@map("users")
}

// 메모
model Memo {
  id           String    @id @default(cuid())
  userId       String
  content      String
  category     String    // "todo" | "diary" | "collected" | "etc"
  classifiedBy String    // "auto" | "manual"
  autoCategory String?
  confidence   Float     @default(0)
  hasDeadline  Boolean   @default(false)
  isDone       Boolean   @default(false)
  doneAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category])
  @@index([userId, deletedAt])
  @@map("memos")
}
