# 데이터베이스 (PostgreSQL)
#
# 연결이 두 개 필요하다. 같은 DB지만 들어가는 문이 다르다:
#   DATABASE_URL - 앱용. 풀링되는 쪽
#   DIRECT_URL   - 마이그레이션용. 트랜잭션·advisory lock 이 그대로 넘어가야 하는 쪽
#
# Supabase (프로젝트 > Connect 에서 복사)
# 앱용 - transaction 모드 풀러 (6543). pgbouncer=true 를 꼭 붙인다
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# 마이그레이션용 - session 모드 풀러 (5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"
#
# Neon 을 쓸 경우 (호스트에 -pooler 가 들어간 쪽이 앱용)
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# JWT 세션 토큰 서명 키 (토스 미니앱용)
JWT_SECRET="your-jwt-secret-key-here-min-32-chars"

# 세션 쿠키 시크릿 (웹용)
SESSION_SECRET="your-session-secret-key-here"

# 미니앱 로그인 식별자 시크릿 - POST /api/auth/toss/verify 가 쓴다. 필수.
#
# 미니앱이 보낸 hash 를 그대로 저장하지 않고 HMAC-SHA256 을 씌워서 저장한다.
# DB 가 통째로 새더라도 어느 값을 보내야 그 계정이 되는지 알 수 없게 하려는 것이다.
# 값이 없으면 verify 경로가 503 을 돌려준다.
#
# ⚠️ 이 값을 잃어버리면 모든 토스 계정이 영영 끊긴다. 같은 사람이 같은 hash 를
#    보내도 다른 providerUserId 가 나와서 빈 계정으로 새로 가입된다.
#    복구 수단이 없다. DEPLOYMENT.md 의 "TOSS_HASH_SECRET" 항목을 읽을 것.
#
# JWT_SECRET 과 같은 값을 쓰지 말 것. JWT 시크릿은 필요하면 갈아끼울 수 있어야
# 하는데 이건 못 갈아끼우는 값이라 수명이 다르다.
#
# 만들기: openssl rand -hex 32
TOSS_HASH_SECRET="openssl-rand-hex-32-로-만든-64자리-hex"

# 미니앱에서 이 서버의 API 를 부를 수 있는 출처. 쉼표로 구분.
# 끝에 / 를 붙이지 말 것 (붙어도 서버가 떼지만, 원래 Origin 헤더에는 없다)
TOSS_ALLOWED_ORIGINS="https://memoindumpy.apps.tossmini.com,https://memoindumpy.private-apps.tossmini.com"

# 카카오 로그인 (웹용)
KAKAO_CLIENT_ID="your-kakao-client-id"
KAKAO_CLIENT_SECRET="your-kakao-client-secret"
KAKAO_REDIRECT_URI="https://your-domain.com/api/auth/kakao/callback"

# 앱 설정
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NODE_ENV="development"

# 관리자 계정 User.id (이 id 로 로그인한 사용자만 관리자 권한)
ADMIN_USER_ID="your-admin-user-cuid"
